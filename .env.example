# ============================================
# Discord Bot Asistent — Environment Template
# ============================================
# Copy this file to `.env` and fill in your values.

# --- Discord (REQUIRED) ---
# Get from https://discord.com/developers/applications
TOKEN_BOT=your_discord_bot_token

# Your personal Discord user ID (snowflake, 17-20 digits).
# This is the ONLY user the bot will respond to.
DISCORD_OWNER_ID=your_discord_id

# --- AI Provider (v1.4.0 — Unified) ---
# Preferred. Any OpenAI-compatible API key works:
#   - OpenRouter: https://openrouter.ai/keys
#   - DeepSeek: https://platform.deepseek.com/api_keys
#   - OpenAI: https://platform.openai.com/api-keys
AI_APIKEY=your_ai_apikey

# Provider base URL. Defaults to OpenRouter.
AI_BASE_URL=https://openrouter.ai/api/v1

# Primary model. Some popular choices:
#   openai/gpt-4o-mini          (vision-capable, fast, cheap)
#   google/gemini-2.0-flash-exp (vision, very cheap)
#   anthropic/claude-3-haiku    (vision, good reasoning)
#   deepseek/deepseek-chat      (text only, very cheap)
#   meta-llama/llama-3.3-70b-instruct
AI_MODEL=openai/gpt-4o-mini

# Fallback used when the primary model fails (3 retries then this).
AI_FALLBACK_MODEL=openai/gpt-3.5-turbo

# --- MongoDB (OPTIONAL) ---
# If missing, snapshot/undo and persistent context are disabled.
# Get a free cluster at https://www.mongodb.com/atlas/database
MONGODB_URI=

# --- Logging (OPTIONAL) ---
# One of: DEBUG | INFO | WARN | ERROR (default: INFO)
LOG_LEVEL=INFO

# If set, also writes JSON log lines to this file.
# LOG_FILE_PATH=./bot.log

# --- Scheduler (OPTIONAL) ---
# IANA timezone name. Default: Asia/Jakarta
SCHEDULER_TIMEZONE=Asia/Jakarta