{
  "name": "asisten-ai",
  "version": "1.3.0",
  "description": "AI-powered Discord management bot with vision, self-healing dynamic commands, and file utilities",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "check": "node --check index.js",
    "dynamic:list": "node -e \"import('./Modules/dynamicExecutor.js').then(m => console.log(m.listDynamicCommands()))\""
  },
  "keywords": [
    "discord",
    "discord-bot",
    "ai",
    "openai",
    "openrouter",
    "management-bot",
    "dynamic-commands",
    "hot-reload",
    "self-extending"
  ],
  "author": "asynx6",
  "license": "ISC",
  "dependencies": {
    "discord.js": "^14.25.1",
    "dotenv": "^17.3.1",
    "mongoose": "^9.6.1",
    "openai": "^6.35.0"
  }
}
